{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nusa-autopilot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NUSA_GLOBAL_RELEASE_FREEZE": "false",
    "NUSA_AUTOPILOT_ZERO_CREDIT_MODE": "true",
    "NUSA_AUTOPILOT_PAID_OVERFLOW_DAILY_CAP": "25",
    "NUSA_JEV_SHADOW_ENABLED": "true",
    "NUSA_JEV_BOUNDED_ROUTING_ENABLED": "false",
    "NUSA_JEV_MODEL_TIERING_ENABLED": "false",
    // FORGE L1 attempt 3 window (owner-approved 2026-11-10; docs/FORGE_L1_VERIFICATION_RUNBOOK.md). Attempt 2 was rejected
    // by the SAN bug fixed in #3048. Turn back to "false" right after this run.
    "NUSA_ISOLATED_CAUSAL_VERIFICATION_ENABLED": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NUSA_EXECUTION_COORDINATOR",
        "class_name": "ExecutionCoordinator"
      }
    ]
  },
  "exports": {
    "ExecutionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Sandbox": {
      "type": "durable-object",
      "state": "deleted"
    }
  }
}
